          "request_id",
          "state",
          "base_run_id",
          "base_snapshot_id",
          "reason_codes",
          "status_url"
        ],
        "title": "RapidBlockResponse",
        "type": "object"
      },
      "RapidBlockState": {
        "enum": [
          "SUBMITTED",
          "VALIDATING",
          "REJECTED",
          "PLANNING",
          "CANDIDATE_READY",
          "NO_CANDIDATE"
        ],
        "title": "RapidBlockState",
        "type": "string"
      },
      "ReplanRequest": {
        "additionalProperties": false,
        "properties": {
          "affected_section_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Affected Section Ids",
            "type": "array"
          },
          "affected_window_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Affected Window Ids",
            "type": "array"
          }
        },
        "required": [
          "affected_section_ids",
          "affected_window_ids"
        ],
        "title": "ReplanRequest",
        "type": "object"
      },
      "ScheduleItem": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "job_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Job Id",
            "type": "string"
          },
          "locked": {
            "default": false,
            "title": "Locked",
            "type": "boolean"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ScheduleStatus"
          },
          "window_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Window Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "window_id",
          "start",
          "end",
          "status",
          "reason_codes"
        ],
        "title": "ScheduleItem",
        "type": "object"
      },
      "ScheduleStatus": {
        "enum": [
          "SCHEDULED",
          "LOCKED",
          "REJECTED"
        ],
        "title": "ScheduleStatus",
        "type": "string"
      },
      "UnscheduledJob": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "reason_codes"
        ],
        "title": "UnscheduledJob",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "row": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Row"
          }
        },
        "required": [
          "code",
          "message",
          "field"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "ValidatorSummary": {
        "additionalProperties": false,
        "properties": {
          "issues": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Issues",
            "type": "array"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "validated_at": {
            "format": "date-time",
            "title": "Validated At",
            "type": "string"
          }
        },
        "required": [
          "passed",
          "validated_at"
        ],
        "title": "ValidatorSummary",
        "type": "object"
      }
    }
  },
